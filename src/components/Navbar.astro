---
// Navbar.astro
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 dark:bg-[#080c14]/85 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo Minimal -->
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-slate-900 text-white dark:bg-cyan-500/10 dark:text-cyan-400 dark:border dark:border-cyan-500/30 flex items-center justify-center font-mono font-bold text-xs tracking-wider">
          IM
        </div>
        <div>
          <span class="text-sm font-bold tracking-tight text-slate-900 dark:text-white font-mono">
            IZZA MAULANA AKBAR
          </span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block -mt-1 font-mono">
            MECHANICAL ENGINEER
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-600 dark:text-slate-300 font-mono">
        <a href="#about" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Tentang</span>
          <span class="lang-en hidden">About</span>
        </a>
        <a href="#experience" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Pengalaman</span>
          <span class="lang-en hidden">Experience</span>
        </a>
        <a href="#projects" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Proyek CAD</span>
          <span class="lang-en hidden">CAD Projects</span>
        </a>
        <a href="#hki" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Inovasi HKI</span>
          <span class="lang-en hidden">Innovation</span>
        </a>
        <a href="#skills" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Keahlian</span>
          <span class="lang-en hidden">Skills</span>
        </a>
        <a href="#certificates" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Sertifikat</span>
          <span class="lang-en hidden">Certificates</span>
        </a>
        <a href="#contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          <span class="lang-id">Kontak</span>
          <span class="lang-en hidden">Contact</span>
        </a>
      </nav>

      <!-- Right Controls: Language & Theme Toggles -->
      <div class="flex items-center gap-2.5">
        
        <!-- Language Switcher Button -->
        <button 
          data-toggle-lang 
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 hover:border-cyan-500 transition text-xs font-mono"
          title="Ganti Bahasa / Switch Language"
          aria-label="Toggle Language"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span id="current-lang-text" class="font-bold">ID</span>
        </button>

        <!-- Dark / Light Mode Switcher Button -->
        <button 
          data-toggle-theme 
          class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 hover:border-cyan-500 transition text-xs"
          title="Ubah Mode Gelap/Terang"
          aria-label="Toggle Dark/Light Mode"
        >
          <!-- Sun icon (for dark mode -> to switch to light) -->
          <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (for light mode -> to switch to dark) -->
          <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-btn" 
          class="md:hidden p-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 hover:border-cyan-500 transition"
          aria-label="Menu"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#080c14]/95 px-4 py-4 space-y-2 font-mono text-xs">
    <a href="#about" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Tentang</span>
      <span class="lang-en hidden">About</span>
    </a>
    <a href="#experience" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Pengalaman Kerja</span>
      <span class="lang-en hidden">Work Experience</span>
    </a>
    <a href="#projects" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Proyek CAD</span>
      <span class="lang-en hidden">CAD Projects</span>
    </a>
    <a href="#hki" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Inovasi HKI</span>
      <span class="lang-en hidden">Innovation & IP</span>
    </a>
    <a href="#skills" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Keahlian</span>
      <span class="lang-en hidden">Skills</span>
    </a>
    <a href="#certificates" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Sertifikat</span>
      <span class="lang-en hidden">Certificates</span>
    </a>
    <a href="#contact" class="block py-1.5 text-slate-700 dark:text-slate-300 hover:text-cyan-500 mobile-link">
      <span class="lang-id">Kontak</span>
      <span class="lang-en hidden">Contact</span>
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
