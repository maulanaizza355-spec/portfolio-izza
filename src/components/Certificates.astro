---
// Certificates.astro
---

<section id="certificates" class="py-16 md:py-20 relative border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="space-y-2 mb-12 reveal-on-scroll">
      <div class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-bold tracking-wider">
        06 // <span class="lang-id">LEGALITAS & BUKTI KOMPETENSI</span><span class="lang-en hidden">CERTIFICATES & LICENSES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        <span class="lang-id">Sertifikasi Resmi</span>
        <span class="lang-en hidden">Official Certifications</span>
      </h2>
    </div>

    <!-- Certificate Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Cert 1: HKI Kemenkumham -->
      <div 
        data-lightbox 
        data-img="/images/sertifikat_hki_desain_industri.png" 
        data-title="Sertifikat Hak Desain Industri (No. IDD000088830) - Kemenkumham RI" 
        data-desc="Mesin silase chopper otomatis berbasis teknologi hybrid - Perlindungan 10 tahun (DJKI Kemenkumham RI)."
        class="card-minimal-hover p-4 flex flex-col group cursor-pointer reveal-on-scroll"
      >
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <img 
            src="/images/sertifikat_hki_desain_industri.png" 
            alt="Sertifikat Hak Desain Industri" 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>
        <div class="pt-3 space-y-1">
          <div class="text-[10px] font-mono text-amber-600 dark:text-amber-400 font-bold">KEMENKUMHAM RI • NO. IDD000088830</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Hak Desain Industri Mesin Chopper
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Perlindungan hukum konfigurasi mekanik mesin silase chopper hybrid.
          </p>
        </div>
      </div>

      <!-- Cert 2: SolidWorks -->
      <div 
        data-lightbox 
        data-img="/images/sertifikat_solidworks.png" 
        data-title="Sertifikat Pelatihan SolidWorks - HMM Universitas Trunodjoyo Madura" 
        data-desc="Pelatihan SolidWorks (Maret 2023) - 2D Sketching, 3D Part Modeling, Assembly, dan Simulasi."
        class="card-minimal-hover p-4 flex flex-col group cursor-pointer reveal-on-scroll"
      >
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <img 
            src="/images/sertifikat_solidworks.png" 
            alt="Sertifikat SolidWorks" 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>
        <div class="pt-3 space-y-1">
          <div class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 font-bold">HMM UNIVERSITAS TRUNODJOYO MADURA</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Pelatihan Software SolidWorks
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Pemodelan part 3D, assembly constraints, dan analisis tegangan dasar.
          </p>
        </div>
      </div>

      <!-- Cert 3: Asisten Praktikum -->
      <div 
        data-lightbox 
        data-img="/images/sertifikat_asisten_lab.jpg" 
        data-title="Sertifikat Asisten Praktikum Proses Manufaktur - FT Universitas Trunodjoyo Madura" 
        data-desc="Semester Genap - Ditandatangani Wakil Dekan I dan Koordinator Program Studi S1 Teknik Mesin."
        class="card-minimal-hover p-4 flex flex-col group cursor-pointer reveal-on-scroll"
      >
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <img 
            src="/images/sertifikat_asisten_lab.jpg" 
            alt="Sertifikat Asisten Praktikum" 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>
        <div class="pt-3 space-y-1">
          <div class="text-[10px] font-mono text-blue-600 dark:text-blue-400 font-bold">FAKULTAS TEKNIK • UNIVERSITAS TRUNODJOYO MADURA</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Asisten Praktikum Proses Manufaktur
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Instruktur lab perencanaan proses, Autodesk Inventor, dan pengelasan.
          </p>
        </div>
      </div>

      <!-- Cert 4: KMI Expo 2024 -->
      <div 
        data-lightbox 
        data-img="/images/sertifikat_kmi_expo.jpg" 
        data-title="Sertifikat Peserta KMI Expo XV 2024 - Kemendikbudristek" 
        data-desc="Pameran Kewirausahaan Mahasiswa Indonesia tingkat nasional di Universitas Halu Oleo Kendari."
        class="card-minimal-hover p-4 flex flex-col group cursor-pointer reveal-on-scroll"
      >
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <img 
            src="/images/sertifikat_kmi_expo.jpg" 
            alt="Sertifikat KMI Expo 2024" 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>
        <div class="pt-3 space-y-1">
          <div class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold">BELMAWA KEMENDIKBUDRISTEK</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Peserta KMI Expo XV 2024 Kendari
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Delegasi resmi pameran produk inovasi genting komposit daur ulang plastik.
          </p>
        </div>
      </div>

      <!-- Cert 5: TEAP English Score 453 -->
      <div 
        data-lightbox 
        data-img="/images/sertifikat_teap.png" 
        data-title="Test Score Record - TEAP English (Universitas Trunodjoyo Madura)" 
        data-desc="Total Score 453 (Listening: 45, Structure: 48, Reading: 43) - Language Center Universitas Trunodjoyo Madura."
        class="card-minimal-hover p-4 flex flex-col group cursor-pointer reveal-on-scroll"
      >
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <img 
            src="/images/sertifikat_teap.png" 
            alt="Sertifikat TEAP English" 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>
        <div class="pt-3 space-y-1">
          <div class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 font-bold">LANGUAGE CENTER • SKOR: 453</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Test of English for Academic Purposes (TEAP)
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Validasi kecakapan bahasa Inggris teknis dan literatur akademik.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
