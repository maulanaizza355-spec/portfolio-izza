---
// Contact.astro
---

<section id="contact" class="py-16 md:py-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="space-y-2 mb-12 reveal-on-scroll">
      <div class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-bold tracking-wider">
        07 // <span class="lang-id">HUBUNGI SAYA</span><span class="lang-en hidden">CONTACT & CONNECT</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        <span class="lang-id">Kontak Langsung</span>
        <span class="lang-en hidden">Get in Touch</span>
      </h2>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 reveal-on-scroll">
      
      <!-- WhatsApp Card -->
      <a 
        href="https://wa.me/6282337969458?text=Halo%20Izza%20Maulana%20Akbar,%20saya%20tertarik%20dengan%20profil%20dan%20keahlian%20teknis%20Anda."
        target="_blank"
        class="card-minimal-hover p-6 flex flex-col justify-between group"
      >
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-500">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.533 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.743 1.54 2.012.353.087.621.058.765-.014.144-.072.39-.448.491-.607.101-.159.202-.13.332-.087s.838.395.982.467c.144.072.24.108.275.166.035.058.035.342-.109.747z"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold uppercase">FAST RESPONSE</div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mt-0.5">WhatsApp</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
              +62 823-3796-9458
            </p>
          </div>
        </div>
        <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold pt-4 group-hover:translate-x-1 transition-transform inline-block">
          Chat Sekarang →
        </span>
      </a>

      <!-- LinkedIn Card -->
      <a 
        href="https://www.linkedin.com/in/izza-maulana-akbar-12b5b1435/"
        target="_blank"
        rel="noopener noreferrer"
        class="card-minimal-hover p-6 flex flex-col justify-between group"
      >
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-600 dark:text-blue-400">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.95 0-1.72.77-1.72 1.72s.77 1.73 1.72 1.73a1.73 1.73 0 0 0 1.73-1.73c0-.95-.78-1.72-1.73-1.72M7.86 18.5v-8.37H5.07v8.37h2.79z"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-mono text-blue-600 dark:text-blue-400 font-bold uppercase">PROFESSIONAL NETWORK</div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mt-0.5">LinkedIn</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
              in/izza-maulana-akbar
            </p>
          </div>
        </div>
        <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold pt-4 group-hover:translate-x-1 transition-transform inline-block">
          Kunjungi Profil →
        </span>
      </a>

      <!-- Email Card -->
      <a 
        href="mailto:maulanaizza355@gmail.com"
        class="card-minimal-hover p-6 flex flex-col justify-between group"
      >
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 font-bold uppercase">EMAIL RESMI</div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mt-0.5">Email</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
              maulanaizza355@gmail.com
            </p>
          </div>
        </div>
        <span class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-bold pt-4 group-hover:translate-x-1 transition-transform inline-block">
          Kirim Email →
        </span>
      </a>

      <!-- Location Card -->
      <div class="card-minimal p-6 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-mono text-indigo-600 dark:text-indigo-400 font-bold uppercase">LOKASI & DOMISILI</div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mt-0.5">Tuban, Jawa Timur</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              Ds. Glagahsari, Kec. Soko
            </p>
          </div>
        </div>
        <span class="text-xs font-mono text-slate-400 pt-4">
          Siap Relokasi
        </span>
      </div>

    </div>

  </div>
</section>
