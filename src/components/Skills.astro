---
// Skills.astro
---

<section id="skills" class="py-16 md:py-20 relative border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="space-y-2 mb-12 reveal-on-scroll">
      <div class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-bold tracking-wider">
        05 // <span class="lang-id">MATRIKS KEAHLIAN & TEKNIK</span><span class="lang-en hidden">TECHNICAL QUALIFICATIONS & SKILLS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        <span class="lang-id">Keahlian & Kompetensi</span>
        <span class="lang-en hidden">Skills & Competencies</span>
      </h2>
    </div>

    <!-- Skills Grid Minimalist -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: Industrial Maintenance & Machinery (Shoe Factory) -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-emerald-500">
        <div>
          <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold uppercase">MAINTENANCE & OPERASIONAL</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Perawatan Mesin Pabrik</span>
            <span class="lang-en hidden">Factory Machine Maintenance</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span><strong>Preventive & Breakdown:</strong> Mesin lini perakitan sepatu.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span><strong>Sistem Pneumatik:</strong> Kalibrasi tekanan, silinder, solenoid valve.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span><strong>Mekanikal Transmisi:</strong> V-belt, pulley, bearing, rantai, gearbox.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span><strong>K3 Manufaktur:</strong> Standar operasional keselamatan kerja bengkel.</span>
          </li>
        </ul>
      </div>

      <!-- Card 2: CAD & 3D Modeling -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-cyan-500">
        <div>
          <span class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 font-bold uppercase">CAD & MODELING</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Perancangan CAD 3D/2D</span>
            <span class="lang-en hidden">3D/2D Mechanical CAD</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-cyan-500 font-bold">✓</span>
            <span><strong>Autodesk Inventor:</strong> Intermediate (Part, Assembly, BOM).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-500 font-bold">✓</span>
            <span><strong>SolidWorks:</strong> Tersertifikasi HMM Universitas Trunodjoyo Madura.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-500 font-bold">✓</span>
            <span><strong>AutoCAD:</strong> 2D Layout & Gambar Ortogonal.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-500 font-bold">✓</span>
            <span><strong>PrusaSlicer:</strong> Slicing toolpath g-code 3D printing FDM.</span>
          </li>
        </ul>
      </div>

      <!-- Card 3: Material Science & ASTM -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-blue-500">
        <div>
          <span class="text-[10px] font-mono text-blue-600 dark:text-blue-400 font-bold uppercase">REKAYASA MATERIAL</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Pengujian Standar ASTM</span>
            <span class="lang-en hidden">ASTM Material Testing</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Pengujian ASTM:</strong> Uji tarik mekanik, bending, dan termal.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Hand Lay-Up:</strong> Pembuatan spesimen komposit polimer.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Kalkulasi Fraksi Volume:</strong> Rasio serat dan matriks resin.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Analisis Sifat Material:</strong> Interpretasi kurva elastisitas/plastisitas.</span>
          </li>
        </ul>
      </div>

      <!-- Card 4: Fabrikasi & Pengelasan -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-amber-500">
        <div>
          <span class="text-[10px] font-mono text-amber-600 dark:text-amber-400 font-bold uppercase">FABRIKASI BENGKEL</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Fabrikasi & Pengelasan</span>
            <span class="lang-en hidden">Fabrication & Welding</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-amber-500 font-bold">✓</span>
            <span><strong>Pengelasan SMAW:</strong> Penyambungan rangka struktur besi hollow.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-500 font-bold">✓</span>
            <span><strong>3D Printing FDM:</strong> Kalibrasi mesin Ender, PLA & PETG.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-500 font-bold">✓</span>
            <span><strong>Operator Mesin:</strong> Gerinda potong, bor duduk, mesin perkakas.</span>
          </li>
        </ul>
      </div>

      <!-- Card 5: Software Riset Data -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-purple-500">
        <div>
          <span class="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-bold uppercase">SOFTWARE RISET</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Analisis Data Riset</span>
            <span class="lang-en hidden">Data Analysis Tools</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-purple-500 font-bold">✓</span>
            <span><strong>Minitab:</strong> Analisis statistik & Desain Eksperimen (DOE).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-purple-500 font-bold">✓</span>
            <span><strong>OriginLab:</strong> Plotting kurva pengujian mekanik material.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-purple-500 font-bold">✓</span>
            <span><strong>MS Office:</strong> Excel olah data teknis, Word, PowerPoint.</span>
          </li>
        </ul>
      </div>

      <!-- Card 6: Manajemen Industri -->
      <div class="card-minimal p-6 space-y-4 reveal-on-scroll border-t-2 border-t-slate-500">
        <div>
          <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400 font-bold uppercase">MANAJEMEN PABRIK</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
            <span class="lang-id">Manajemen Operasional</span>
            <span class="lang-en hidden">Operations Management</span>
          </h3>
        </div>

        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-slate-500 font-bold">✓</span>
            <span><strong>PPIC:</strong> Production Planning and Material Control.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-slate-500 font-bold">✓</span>
            <span><strong>Troubleshooting:</strong> Analisis akar penyebab kendala mesin.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-slate-500 font-bold">✓</span>
            <span><strong>Kewirausahaan:</strong> Validasi produk dan pitching industri.</span>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>
