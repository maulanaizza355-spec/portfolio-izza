---
// Footer.astro
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#060910] py-10 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
      
      <!-- Brand & University -->
      <div class="text-center md:text-left">
        <div class="font-bold text-slate-800 dark:text-slate-200">
          IZZA MAULANA AKBAR, S.T.
        </div>
        <div class="text-[11px] mt-0.5">
          Universitas Trunodjoyo Madura • Mekanik PT. Shou Fong Lastindo
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-[11px]">
        <a href="#about" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Tentang</a>
        <a href="#experience" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Pengalaman</a>
        <a href="#projects" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Proyek CAD</a>
        <a href="#hki" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Inovasi HKI</a>
        <a href="#skills" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Keahlian</a>
        <a href="#certificates" class="hover:text-cyan-400 transition">Sertifikat</a>
        <a href="https://www.linkedin.com/in/izza-maulana-akbar-12b5b1435/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline font-bold">LinkedIn ↗</a>
        <a href="#contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition">Kontak</a>
      </div>

      <!-- Copyright -->
      <div class="text-[11px] text-center md:text-right">
        © 2026 • Astro.js & Bun
      </div>

    </div>
  </div>
</footer>
