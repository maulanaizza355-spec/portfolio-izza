---
// InnovationHKI.astro
---

<section id="hki" class="py-16 md:py-20 relative border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="space-y-2 mb-12 reveal-on-scroll">
      <div class="text-xs font-mono text-amber-600 dark:text-amber-400 font-bold tracking-wider">
        03 // <span class="lang-id">HAK KEKAYAAN INTELEKTUAL RESMI</span><span class="lang-en hidden">INTELLECTUAL PROPERTY & PATENTS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        <span class="lang-id">Hak Desain Industri Kemenkumham RI</span>
        <span class="lang-en hidden">Official Industrial Design Patent</span>
      </h2>
    </div>

    <!-- HKI Spotlight Card (Minimalist) -->
    <div class="card-minimal p-6 sm:p-8 space-y-6 reveal-on-scroll">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Certificate Details (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
            <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 font-bold">
              SERTIFIKAT HKI RESMI
            </span>
            <span class="px-2.5 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400">
              NO: IDD000088830
            </span>
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
              <span class="lang-id">PERLINDUNGAN 10 TAHUN</span>
              <span class="lang-en hidden">10-YEAR PROTECTION</span>
            </span>
          </div>

          <div class="space-y-1">
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
              Mesin Silase Chopper Otomatis Berbasis Teknologi Hybrid
            </h3>
            <p class="text-xs font-mono text-cyan-600 dark:text-cyan-400">
              Direktorat Jenderal Kekayaan Intelektual • Kementerian Hukum RI
            </p>
          </div>

          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            <span class="lang-id">
              Desain konfigurasi mekanikal mesin perajang pakan silase ternak otomatis dengan sistem penggerak hybrid. Mengoptimalkan laju cacahan serat pakan, memangkas konsumsi energi, dan meningkatkan keselamatan operator peternakan.
            </span>
            <span class="lang-en hidden">
              Mechanical configuration design for an automated hybrid silage chopper machine. Optimizes feed chopping rates, cuts energy consumption, and enhances farm operator safety standards.
            </span>
          </p>

          <!-- Specs Table -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1 text-xs font-mono">
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
              <span class="text-slate-400 block text-[10px]">OBJEK PERLINDUNGAN</span>
              <span class="text-slate-800 dark:text-slate-200 font-bold">Bentuk & Konfigurasi Mesin</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
              <span class="text-slate-400 block text-[10px]">INSTITUSI PEMEGANG</span>
              <span class="text-slate-800 dark:text-slate-200">Universitas Trunodjoyo Madura</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 sm:col-span-2">
              <span class="text-slate-400 block text-[10px]">PENDESAIN TERDAFTAR</span>
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">Izza Maulana Akbar, S.T. (dkk)</span>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-2.5 pt-2 font-mono text-xs">
            <button 
              data-lightbox 
              data-img="/images/sertifikat_hki_desain_industri.png" 
              data-title="Sertifikat Hak Desain Industri Kemenkumham RI (No. IDD000088830)" 
              data-desc="Mesin silase chopper otomatis berbasis teknologi hybrid - Terdaftar resmi di DJKI Kemenkumham RI."
              class="px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition flex items-center gap-1.5"
            >
              <span class="lang-id">Buka Lembar Sertifikat</span>
              <span class="lang-en hidden">View Official Certificate</span>
            </button>

            <button 
              data-lightbox 
              data-img="/images/lampiran_hki_desain_industri.png" 
              data-title="Lampiran Resmi Pendesain - Kemenkumham RI" 
              data-desc="Verifikasi nama pendesain resmi tercatat: Izza Maulana Akbar bersama tim inventor Universitas Trunodjoyo Madura."
              class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition flex items-center gap-1.5"
            >
              <span class="lang-id">Verifikasi Nama Pendesain</span>
              <span class="lang-en hidden">Verify Designer Names</span>
            </button>
          </div>
        </div>

        <!-- Right: Certificate Visual (5 cols) -->
        <div class="lg:col-span-5 flex justify-center">
          <div 
            data-lightbox 
            data-img="/images/sertifikat_hki_desain_industri.png" 
            data-title="Sertifikat Hak Desain Industri Kemenkumham RI (No. IDD000088830)" 
            data-desc="Mesin silase chopper otomatis berbasis teknologi hybrid"
            class="max-w-xs rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 cursor-pointer shadow-sm hover:border-amber-500 transition group"
          >
            <img 
              src="/images/sertifikat_hki_desain_industri.png" 
              alt="Sertifikat Desain Industri Mesin Chopper" 
              class="w-full h-auto object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
