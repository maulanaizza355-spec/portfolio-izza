---
// Hero.astro
---

<section class="relative pt-12 pb-16 md:pt-16 md:pb-24 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Bio & Value Proposition (7 cols) -->
      <div class="lg:col-span-7 space-y-5 text-center lg:text-left reveal-on-scroll">
        
        <!-- Status Pill: Current Role -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-cyan-600 dark:text-cyan-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="lang-id">Mekanik • PT. Shou Fong Lastindo (2026 - Sekarang)</span>
          <span class="lang-en hidden">Mechanical Technician • PT. Shou Fong Lastindo (2026 - Present)</span>
        </div>

        <!-- Name & Professional Title -->
        <div class="space-y-2">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight font-sans">
            Izza Maulana Akbar, <span class="text-cyan-600 dark:text-cyan-400">S.T.</span>
          </h1>
          <p class="text-lg sm:text-xl font-medium text-slate-600 dark:text-slate-300">
            <span class="lang-id">Sarjana Teknik Mesin | Rekayasa Material & Maintenance</span>
            <span class="lang-en hidden">Mechanical Engineer | Material Engineering & Maintenance</span>
          </p>
        </div>

        <!-- Brief Narrative -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl mx-auto lg:mx-0">
          <span class="lang-id">
            Lulusan S1 Teknik Mesin <strong class="text-slate-900 dark:text-slate-200">Universitas Trunodjoyo Madura</strong> (IPK 3.42). Saat ini aktif berkarya sebagai <strong class="text-cyan-600 dark:text-cyan-300">Mekanik di PT. Shou Fong Lastindo</strong>. Memiliki spesialisasi dalam perawatan mesin industri, perancangan CAD (Inventor & SolidWorks), riset komposit berstandar ASTM, serta pemegang <strong class="text-amber-600 dark:text-amber-400">Hak Desain Industri Kemenkumham RI</strong>.
          </span>
          <span class="lang-en hidden">
            Mechanical Engineering graduate from <strong class="text-slate-900 dark:text-slate-200">Universitas Trunodjoyo Madura</strong> (GPA 3.42). Currently working as a <strong class="text-cyan-600 dark:text-cyan-300">Mechanical Technician at PT. Shou Fong Lastindo</strong>. Specializes in industrial machinery maintenance, 3D CAD design (Inventor & SolidWorks), ASTM composite research, and an official <strong class="text-amber-600 dark:text-amber-400">Industrial Design Patent Holder</strong> from the Ministry of Law and Human Rights RI.
          </span>
        </p>

        <!-- Minimalist Highlights Chips -->
        <div class="flex flex-wrap gap-2 justify-center lg:justify-start pt-1 font-mono text-xs">
          <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            ✓ PT. Shou Fong Lastindo
          </span>
          <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            ✓ HKI No. IDD000088830
          </span>
          <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            ✓ SolidWorks & Inventor
          </span>
          <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            ✓ ASTM Testing
          </span>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-3">
          <a 
            href="#projects" 
            class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-cyan-500 hover:bg-slate-800 dark:hover:bg-cyan-400 text-white dark:text-slate-950 font-bold text-xs font-mono transition shadow-sm"
          >
            <span class="lang-id">Lihat Portofolio Proyek</span>
            <span class="lang-en hidden">Explore CAD Projects</span>
          </a>

          <a 
            href="https://www.linkedin.com/in/izza-maulana-akbar-12b5b1435/" 
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white font-medium text-xs font-mono transition flex items-center gap-2 shadow-sm"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.95 0-1.72.77-1.72 1.72s.77 1.73 1.72 1.73a1.73 1.73 0 0 0 1.73-1.73c0-.95-.78-1.72-1.73-1.72M7.86 18.5v-8.37H5.07v8.37h2.79z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a 
            href="https://wa.me/6282337969458?text=Halo%20Izza%20Maulana%20Akbar,%20saya%20melihat%20web%20portofolio%20Anda." 
            target="_blank"
            class="px-5 py-2.5 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-medium text-xs font-mono border border-slate-200 dark:border-slate-800 transition flex items-center gap-2"
          >
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.533 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.743 1.54 2.012.353.087.621.058.765-.014.144-.072.39-.448.491-.607.101-.159.202-.13.332-.087s.838.395.982.467c.144.072.24.108.275.166.035.058.035.342-.109.747z"/>
            </svg>
            <span>WhatsApp</span>
          </a>

          <a 
            href="#contact"
            class="px-4 py-2.5 text-xs text-slate-500 hover:text-cyan-600 dark:hover:text-cyan-400 font-mono transition"
          >
            <span class="lang-id">Kontak Langsung ↓</span>
            <span class="lang-en hidden">Get in Touch ↓</span>
          </a>
        </div>

        <!-- Minimal Metrics Counter Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-5 border-t border-slate-200 dark:border-slate-800">
          <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class="text-xl font-bold text-cyan-600 dark:text-cyan-400 font-mono">2026</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              <span class="lang-id">Mekanik Aktif</span>
              <span class="lang-en hidden">Active Mechanic</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 font-mono">1 HKI</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              <span class="lang-id">Desain Industri</span>
              <span class="lang-en hidden">Official Patent</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 font-mono">3.42</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              <span class="lang-id">IPK Mesin UTM</span>
              <span class="lang-en hidden">GPA UTM</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class="text-xl font-bold text-blue-600 dark:text-blue-400 font-mono">453</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              <span class="lang-id">Skor TEAP English</span>
              <span class="lang-en hidden">TEAP Score</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Minimalist Photo Card (5 cols) -->
      <div class="lg:col-span-5 flex justify-center reveal-on-scroll">
        <div class="relative w-full max-w-xs sm:max-w-sm">
          
          <div class="card-minimal p-4 shadow-sm border border-slate-200 dark:border-slate-800">
            
            <div class="flex items-center justify-between pb-3 text-[10px] font-mono text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
              <span>ID: 220481100025</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                ACTIVE
              </span>
            </div>

            <!-- Profile Photo -->
            <div class="relative mt-3 rounded-xl overflow-hidden aspect-[3/4] bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
              <img 
                src="/images/profile.jpg" 
                alt="Izza Maulana Akbar, S.T." 
                class="w-full h-full object-cover object-top filter brightness-100 dark:brightness-105"
              />
            </div>

            <!-- Caption below photo -->
            <div class="mt-3 pt-2 text-center">
              <div class="text-sm font-bold text-slate-900 dark:text-white font-mono">
                IZZA MAULANA AKBAR, S.T.
              </div>
              <div class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
                Universitas Trunodjoyo Madura
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
